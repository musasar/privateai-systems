---
---
<!-- About Section with Founder Photo -->
<section id="about" class="section-padding bg-white">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="relative">
        <!-- Lab / workstation photo -->
        <div class="relative aspect-[4/3] rounded-2xl overflow-hidden bg-gray-100">
          <img 
            src="/images/about-team.jpg" 
            alt="PrivateAI Systems lab — on-premise AI workstation running Ubuntu, Docker, and local AI models"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="eager"
            fetchpriority="high"
          />
          <!-- Decorative overlay -->
          <div class="absolute inset-0 bg-gradient-to-br from-indigo-600/10 via-transparent to-purple-600/10 pointer-events-none"></div>
        </div>
        <!-- Floating badge -->
        <div class="absolute -bottom-6 -left-6 md:-left-8 bg-white/95 backdrop-blur-sm rounded-2xl border border-gray-100 p-6 md:p-8 shadow-2xl animate-slide-up">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-indigo-100 flex items-center justify-center">
              <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-3xl font-bold text-gray-900">100%</p>
              <p class="text-sm text-gray-600">On-Premise &bull; No Cloud</p>
            </div>
          </div>
        </div>
      </div>
      
      <div>
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-50 text-indigo-700 text-sm font-medium mb-6">
          <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
          About PrivateAI Systems
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 leading-tight mb-6">
          Private AI Infrastructure<br class="hidden sm:block" />
          <span class="gradient-text">Built for European Businesses</span>
        </h2>
        <p class="text-lg text-gray-600 mb-6 leading-relaxed">
          Founded by a Linux and AI infrastructure engineer specializing in private, on-premise AI deployments. 
          We design and build secure AI systems that run entirely inside your company's infrastructure &mdash; 
          no cloud dependencies, no data leakage, no vendor lock-in.
        </p>
        <p class="text-gray-600 mb-8 leading-relaxed">
          We are currently accepting pilot projects across Europe. Every deployment is custom-built 
          for your specific needs, fully documented, and supported long-term. Our approach is transparent, 
          open-source-first, and privacy-by-design.
        </p>
        
        <div class="grid grid-cols-2 gap-4 mb-8">
          <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl">
            <div class="w-10 h-10 rounded-lg bg-indigo-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">Data Sovereignty</p>
              <p class="text-sm text-gray-600">Your data stays in your building</p>
            </div>
          </div>
          <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl">
            <div class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">Open Source Stack</p>
              <p class="text-sm text-gray-600">No proprietary lock-in</p>
            </div>
          </div>
          <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl">
            <div class="w-10 h-10 rounded-lg bg-purple-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 00-5.656 0l-4 4a4 4 0 005.656 5.656l1.102-1.101m-.758-4.899a4 4 0 00-5.656 0l-4 4a4 4 0 005.656 5.656l1.102-1.101" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">Privacy by Design</p>
              <p class="text-sm text-gray-600">Designed for GDPR Principles</p>
            </div>
          </div>
          <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl">
            <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">On-Site Deployment</p>
              <p class="text-sm text-gray-600">Direct engineer support in EU</p>
            </div>
          </div>
        </div>
        
        <a href="#contact" class="btn-primary inline-flex items-center gap-2">
          Start Your Project
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Example Deployments -->
<section id="deployments" class="section-padding bg-gray-50">
  <div class="container-custom">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Example Deployments</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">Reference architectures designed for specific business scenarios — not stock photos, real configurations we build.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Law Firm -->
      <div class="card relative overflow-hidden group">
        <div class="relative aspect-video overflow-hidden rounded-t-2xl">
          <img 
            src="/images/ai-workstation.jpg" 
            alt="AI workstation for on-premise deployment"
            class="w-full h-full object-cover"
            loading="lazy"
            fetchpriority="low"
          />
          <div class="absolute top-3 left-3">
            <span class="px-3 py-1 bg-indigo-600 text-white text-xs font-semibold rounded-full">Example</span>
          </div>
        </div>
        <div class="p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-2">Law Firm (15 employees)</h3>
          <p class="text-gray-600 text-sm mb-3">
            Ubuntu Server + Ollama + Open WebUI + Qdrant RAG for secure document search and contract analysis. VPN remote access for partners working from home.
          </p>
          <ul class="space-y-1 text-sm text-gray-500">
            <li>&bull; RTX 4060 &bull; 32GB RAM &bull; 1TB NVMe</li>
            <li>&bull; Llama 3 8B + Qwen 2.5 8B</li>
            <li>&bull; Daily encrypted backups</li>
          </ul>
        </div>
      </div>

      <!-- Example: Engineering -->
      <div class="card relative overflow-hidden group">
        <div class="relative aspect-video overflow-hidden rounded-t-2xl">
          <img 
            src="/images/datacenter-rack.jpg" 
            alt="Reference architecture for engineering firms"
            class="w-full h-full object-cover"
            loading="lazy"
            fetchpriority="low"
          />
          <div class="absolute top-3 left-3">
            <span class="px-3 py-1 bg-indigo-600 text-white text-xs font-medium rounded-full">
              Example
            </span>
          </div>
        </div>
        <div class="p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-2">Engineering Office (25 employees)</h3>
          <p class="text-gray-600 text-sm mb-3">
            Local code generation agents + technical documentation RAG. GPU-accelerated inference without cloud latency.
          </p>
          <ul class="space-y-1 text-gray-600 text-sm">
            <li>&bull; RTX 4070 &bull; 64GB RAM &bull; 2TB NVMe</li>
            <li>&bull; DeepSeek Coder + Llama 3 70B</li>
            <li>&bull; VPN + SSL + Firewall</li>
          </ul>
        </div>
      </div>

      <!-- Example: Healthcare -->
      <div class="card relative overflow-hidden group">
        <div class="relative aspect-video overflow-hidden rounded-t-2xl">
          <img 
            src="/images/server-closeup.jpg" 
            alt="Server hardware configuration"
            class="w-full h-full object-cover"
            loading="lazy"
            fetchpriority="low"
          />
          <div class="absolute top-3 left-3">
            <span class="px-3 py-1 bg-indigo-600 text-white text-xs font-semibold rounded-full">
              Example
            </span>
          </div>
        </div>
        <div class="p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-2">Healthcare Clinic (40 employees)</h3>
          <p class="text-gray-600 text-sm mb-3">
            GDPR-principle-compliant AI assistant for patient scheduling, medical literature search, and administrative automation.
          </p>
          <ul class="space-y-1 text-gray-600 text-sm">
            <li>&bull; 2&times; RTX 4080S &bull; 128GB RAM</li>
            <li>&bull; Fine-tuned medical RAG models</li>
            <li>&bull; Air-gapped network option</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes slide-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-slide-up {
    animation: slide-up 0.6s ease-out forwards;
  }
</style>