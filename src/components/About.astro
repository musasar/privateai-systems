---
---
<!-- About Section with Team Photo -->
<section id="about" class="section-padding bg-white">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="relative">
        <!-- Main team photo -->
        <div class="relative aspect-[4/3] rounded-2xl overflow-hidden bg-gray-100">
          <img 
            src="/images/about-team.jpg" 
            alt="PrivateAI Systems team collaborating on AI infrastructure"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="eager"
          />
          <!-- Decorative overlay -->
          <div class="absolute inset-0 bg-gradient-to-br from-indigo-600/10 via-transparent to-purple-600/10 pointer-events-none"></div>
        </div>
        <!-- Floating stat badge -->
        <div class="absolute -bottom-6 -left-6 md:-left-8 bg-white/95 backdrop-blur-sm rounded-2xl border border-gray-100 p-6 md:p-8 shadow-2xl animate-slide-up">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-indigo-100 flex items-center justify-center">
              <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div>
              <p class="text-3xl font-bold text-gray-900">15+</p>
              <p class="text-sm text-gray-600">AI Engineers & System Architects</p>
            </div>
          </div>
        </div>
      </div>
      
      <div>
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-50 text-indigo-700 text-sm font-medium mb-6">
          <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
          About PrivateAI Systems
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 leading-tight mb-6">
          Building Europe's Most Trusted<br class="hidden sm:block" />
          <span class="gradient-text">Private AI Infrastructure</span>
        </h2>
        <p class="text-lg text-gray-600 mb-6 leading-relaxed">
          We are a team of system architects, AI engineers, and infrastructure specialists 
          who believe that European businesses deserve AI sovereignty. No cloud dependencies. 
          No data leakage. No vendor lock-in.
        </p>
        <p class="text-gray-600 mb-8 leading-relaxed">
          Founded in 2024, we've deployed 50+ on-premise AI systems across Germany, France, 
          Netherlands, and Switzerland — from law firms and healthcare clinics to manufacturing 
          plants and government agencies. Every deployment is custom-built, fully documented, 
          and supported long-term.
        </p>
        
        <div class="grid grid-cols-2 gap-4 mb-8">
          <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl">
            <div class="w-10 h-10 rounded-lg bg-indigo-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">GDPR Native</p>
              <p class="text-sm text-gray-600">EU data sovereignty by design</p>
            </div>
          </div>
          <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl">
            <div class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20 10 10 0 000-20z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">24/7 Monitoring</p>
              <p class="text-sm text-gray-600">Proactive system health</p>
            </div>
          </div>
          <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl">
            <div class="w-10 h-10 rounded-lg bg-purple-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 00-5.656 0l-4 4a4 4 0 005.656 5.656l1.102-1.101m-.758-4.899a4 4 0 00-5.656 0l-4 4a4 4 0 005.656 5.656l1.102-1.101" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">Open Source Stack</p>
              <p class="text-sm text-gray-600">No proprietary black boxes</p>
            </div>
          </div>
          <div class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl">
            <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">On-Site Deployment</p>
              <p class="text-sm text-gray-600">We come to you, anywhere in EU</p>
            </div>
          </div>
        </div>
        
        <a href="#contact" class="btn-primary inline-flex items-center gap-2">
          Start Your Project
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Infrastructure Showcase -->
<section id="infrastructure" class="section-padding bg-gray-50">
  <div class="container-custom">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Our Infrastructure in Action</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">Real deployments, real hardware, real results — no stock photos of our actual work.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Datacenter Rack -->
      <article class="card relative overflow-hidden group">
        <div class="relative aspect-video overflow-hidden">
          <img 
            src="/images/datacenter-rack.jpg" 
            alt="Enterprise server rack with GPU accelerators"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="absolute bottom-4 left-4 right-4 transform translate-y-full group-hover:translate-y-0 transition-transform duration-300">
            <h3 class="text-xl font-bold text-white mb-1">Enterprise GPU Cluster</h3>
            <p class="text-white/90 text-sm">RTX 4090 × 8 • 512GB RAM • 100GbE</p>
          </div>
        </div>
        <div class="p-6">
          <div class="flex items-center gap-2 text-sm text-gray-600 mb-3">
            <span class="w-2 h-2 rounded-full bg-green-500"></span>
            <span>Active Deployment • Munich, DE</span>
          </div>
          <p class="text-gray-600 text-sm">Financial services client running Llama-3-70B + custom fine-tunes for document analysis. 99.9% uptime since deployment.</p>
        </div>
      </article>
      
      <!-- AI Workstation -->
      <article class="card relative overflow-hidden group">
        <div class="relative aspect-video overflow-hidden">
          <img 
            src="/images/ai-workstation.jpg" 
            alt="High-performance AI workstation with liquid cooling"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="absolute bottom-4 left-4 right-4 transform translate-y-full group-hover:translate-y-0 transition-transform duration-300">
            <h3 class="text-xl font-bold text-white mb-1">AI Development Workstation</h3>
            <p class="text-white/90 text-sm">RTX 4070 • 128GB RAM • Dual GPU Ready</p>
          </div>
        </div>
        <div class="p-6">
          <div class="flex items-center gap-2 text-sm text-gray-600 mb-3">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            <span>Active Deployment • Zurich, CH</span>
          </div>
          <p class="text-gray-600 text-sm">Engineering firm using local code generation agents + RAG for technical documentation. 40% faster development cycles.</p>
        </div>
      </article>
      
      <!-- Server Closeup -->
      <article class="card relative overflow-hidden group md:col-span-2">
        <div class="relative aspect-[21/9] overflow-hidden">
          <img 
            src="/images/server-closeup.jpg" 
            alt="Server hardware detail with GPU and networking"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="absolute bottom-6 left-6 right-6 transform translate-y-full group-hover:translate-y-0 transition-transform duration-300">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4">
                <p class="text-2xl font-bold text-white">RTX 4090</p>
                <p class="text-white/80 text-sm">24GB VRAM × 4</p>
              </div>
              <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4">
                <p class="text-2xl font-bold text-white">512 GB</p>
                <p class="text-white/80 text-sm">DDR5 ECC RAM</p>
              </div>
              <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4">
                <p class="text-2xl font-bold text-white">100 GbE</p>
                <p class="text-white/80 text-sm">Mellanox ConnectX-7</p>
              </div>
            </div>
          </div>
        </div>
        <div class="p-6">
          <div class="flex items-center gap-2 text-sm text-gray-600 mb-3">
            <span class="w-2 h-2 rounded-full bg-purple-500"></span>
            <span>Reference Architecture • Enterprise Tier</span>
          </div>
          <p class="text-gray-600">Our flagship enterprise configuration: 4× RTX 4090 in custom liquid-cooled chassis, redundant 2000W PSUs, hardware RAID, out-of-band management. Delivered turnkey with full AI stack pre-installed.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  @keyframes slide-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-slide-up {
    animation: slide-up 0.6s ease-out forwards;
  }
</style>