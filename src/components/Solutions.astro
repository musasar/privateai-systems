---
---

<section id="solutions" class="section-padding bg-white" aria-labelledby="solutions-title">
  <div class="container-custom">
    <div class="text-center mb-16">
      <h2 id="solutions-title" class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Complete AI Infrastructure</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">We don't just install software. We build complete AI systems for your business.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="card group relative overflow-hidden">
        <!-- AI Server Illustration -->
        <div class="absolute top-4 right-4 w-32 h-32 opacity-10 group-hover:opacity-20 transition-opacity duration-500" aria-hidden="true">
          <svg viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="16" y="8" width="96" height="112" rx="8" stroke="#4F46E5" stroke-width="2"/>
            <rect x="24" y="20" width="80" height="12" rx="2" fill="#4F46E5" opacity="0.3"/>
            <rect x="24" y="40" width="80" height="36" rx="4" stroke="#7C3AED" stroke-width="1.5"/>
            <circle cx="44" cy="58" r="6" fill="#4F46E5" opacity="0.5"/>
            <circle cx="84" cy="58" r="6" fill="#7C3AED" opacity="0.5"/>
            <rect x="36" y="88" width="56" height="20" rx="4" stroke="#4F46E5" stroke-width="1.5"/>
            <line x1="44" y1="98" x2="84" y2="98" stroke="#7C3AED" stroke-width="2"/>
            <line x1="64" y1="90" x2="64" y2="106" stroke="#4F46E5" stroke-width="1.5" stroke-dasharray="4 4"/>
          </svg>
        </div>
        <div class="w-12 h-12 rounded-lg bg-indigo-100 flex items-center justify-center mb-4 group-hover:bg-indigo-200 transition-colors relative z-10">
          <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2 relative z-10">AI Servers</h3>
        <p class="text-gray-600 relative z-10">Custom-built AI workstations designed around your workload needs, assembled and configured on-site.</p>
      </div>
      <div class="card group relative overflow-hidden">
        <!-- Neural Network Illustration -->
        <div class="absolute top-4 right-4 w-32 h-32 opacity-10 group-hover:opacity-20 transition-opacity duration-500" aria-hidden="true">
          <svg viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <radialGradient id="nodeGrad" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#7C3AED"/>
                <stop offset="100%" stop-color="#4F46E5"/>
              </radialGradient>
            </defs>
            <circle cx="32" cy="32" r="8" fill="url(#nodeGrad)" opacity="0.6"/>
            <circle cx="96" cy="32" r="8" fill="url(#nodeGrad)" opacity="0.6"/>
            <circle cx="64" cy="64" r="10" fill="url(#nodeGrad)" opacity="0.8"/>
            <circle cx="32" cy="96" r="8" fill="url(#nodeGrad)" opacity="0.6"/>
            <circle cx="96" cy="96" r="8" fill="url(#nodeGrad)" opacity="0.6"/>
            <line x1="32" y1="32" x2="64" y2="64" stroke="#7C3AED" stroke-width="1.5" opacity="0.4"/>
            <line x1="96" y1="32" x2="64" y2="64" stroke="#4F46E5" stroke-width="1.5" opacity="0.4"/>
            <line x1="32" y1="96" x2="64" y2="64" stroke="#7C3AED" stroke-width="1.5" opacity="0.4"/>
            <line x1="96" y1="96" x2="64" y2="64" stroke="#4F46E5" stroke-width="1.5" opacity="0.4"/>
            <line x1="32" y1="32" x2="32" y2="96" stroke="#7C3AED" stroke-width="1" opacity="0.2" stroke-dasharray="4 4"/>
            <line x1="96" y1="32" x2="96" y2="96" stroke="#4F46E5" stroke-width="1" opacity="0.2" stroke-dasharray="4 4"/>
          </svg>
        </div>
        <div class="w-12 h-12 rounded-lg bg-purple-100 flex items-center justify-center mb-4 group-hover:bg-purple-200 transition-colors relative z-10">
          <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" /></svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2 relative z-10">Local AI Models</h3>
        <p class="text-gray-600 relative z-10">Deploy Llama, Qwen, Gemma, DeepSeek, Mistral, and custom fine-tuned models on your own hardware.</p>
      </div>
      <div class="card group relative overflow-hidden">
        <!-- AI Agent Illustration -->
        <div class="absolute top-4 right-4 w-32 h-32 opacity-10 group-hover:opacity-20 transition-opacity duration-500" aria-hidden="true">
          <svg viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="24" y="16" width="80" height="96" rx="16" stroke="#10B981" stroke-width="2"/>
            <circle cx="64" cy="48" r="16" fill="#10B981" opacity="0.2"/>
            <circle cx="64" cy="48" r="10" fill="#10B981" opacity="0.4"/>
            <circle cx="56" cy="44" r="2" fill="white"/>
            <circle cx="72" cy="44" r="2" fill="white"/>
            <path d="M48 68 Q64 78 80 68" stroke="#10B981" stroke-width="3" stroke-linecap="round" fill="none"/>
            <line x1="40" y1="96" x2="88" y2="96" stroke="#10B981" stroke-width="2" stroke-dasharray="8 4"/>
            <circle cx="64" cy="96" r="4" fill="#10B981" opacity="0.5"/>
          </svg>
        </div>
        <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center mb-4 group-hover:bg-green-200 transition-colors relative z-10">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2 relative z-10">AI Agents</h3>
        <p class="text-gray-600 relative z-10">Automate repetitive work using intelligent AI agents that integrate with your existing tools.</p>
      </div>
      <div class="card group relative overflow-hidden">
        <!-- Knowledge Base Illustration -->
        <div class="absolute top-4 right-4 w-32 h-32 opacity-10 group-hover:opacity-20 transition-opacity duration-500" aria-hidden="true">
          <svg viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="16" y="12" width="96" height="104" rx="4" stroke="#F59E0B" stroke-width="2"/>
            <line x1="16" y1="32" x2="112" y2="32" stroke="#F59E0B" stroke-width="1.5"/>
            <rect x="24" y="16" width="88" height="12" rx="2" fill="#F59E0B" opacity="0.2"/>
            <line x1="32" y1="48" x2="96" y2="48" stroke="#F59E0B" stroke-width="1" opacity="0.5"/>
            <line x1="32" y1="60" x2="88" y2="60" stroke="#F59E0B" stroke-width="1" opacity="0.5"/>
            <line x1="32" y1="72" x2="96" y2="72" stroke="#F59E0B" stroke-width="1" opacity="0.5"/>
            <line x1="32" y1="84" x2="80" y2="84" stroke="#F59E0B" stroke-width="1" opacity="0.5"/>
            <circle cx="100" cy="60" r="8" fill="#F59E0B" opacity="0.3"/>
            <path d="M96 56 L104 60 L96 64" stroke="#F59E0B" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="w-12 h-12 rounded-lg bg-amber-100 flex items-center justify-center mb-4 group-hover:bg-amber-200 transition-colors relative z-10">
          <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2 relative z-10">Knowledge Base</h3>
        <p class="text-gray-600 relative z-10">Your company documents become searchable and queryable by AI — PDFs, documents, contracts, manuals.</p>
      </div>
      <div class="card group relative overflow-hidden">
        <!-- Maintenance Illustration -->
        <div class="absolute top-4 right-4 w-32 h-32 opacity-10 group-hover:opacity-20 transition-opacity duration-500" aria-hidden="true">
          <svg viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="64" cy="64" r="40" stroke="#EF4444" stroke-width="2" stroke-dasharray="8 4"/>
            <circle cx="64" cy="64" r="30" stroke="#EF4444" stroke-width="1.5" opacity="0.5"/>
            <path d="M64 24 L64 40" stroke="#EF4444" stroke-width="3" stroke-linecap="round"/>
            <path d="M64 88 L64 104" stroke="#EF4444" stroke-width="3" stroke-linecap="round"/>
            <path d="M24 64 L40 64" stroke="#EF4444" stroke-width="3" stroke-linecap="round"/>
            <path d="M88 64 L104 64" stroke="#EF4444" stroke-width="3" stroke-linecap="round"/>
            <circle cx="64" cy="64" r="8" fill="#EF4444" opacity="0.3"/>
            <path d="M64 56 L64 60 M60 64 L68 64" stroke="#EF4444" stroke-width="3" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="w-12 h-12 rounded-lg bg-red-100 flex items-center justify-center mb-4 group-hover:bg-red-200 transition-colors relative z-10">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20 10 10 0 000-20z" /></svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2 relative z-10">Maintenance & Support</h3>
        <p class="text-gray-600 relative z-10">Updates, monitoring, model optimization, and ongoing remote support. We keep your system running.</p>
      </div>
      <div class="card group relative overflow-hidden">
        <!-- Training Illustration -->
        <div class="absolute top-4 right-4 w-32 h-32 opacity-10 group-hover:opacity-20 transition-opacity duration-500" aria-hidden="true">
          <svg viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="64" cy="36" r="16" fill="#0D9488" opacity="0.3"/>
            <circle cx="64" cy="36" r="10" fill="#0D9488" opacity="0.6"/>
            <path d="M64 28 L64 20 M56 36 L48 36 M72 36 L80 36" stroke="#0D9488" stroke-width="2" stroke-linecap="round"/>
            <path d="M32 88 L96 88" stroke="#0D9488" stroke-width="3" stroke-linecap="round"/>
            <path d="M32 88 L48 104 L80 72 L96 88" stroke="#0D9488" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <circle cx="48" cy="104" r="4" fill="#0D9488" opacity="0.5"/>
            <circle cx="80" cy="72" r="4" fill="#0D9488" opacity="0.5"/>
            <circle cx="96" cy="88" r="4" fill="#0D9488" opacity="0.5"/>
            <rect x="24" y="104" width="80" height="12" rx="6" fill="#0D9488" opacity="0.2"/>
            <text x="64" y="112" text-anchor="middle" font-size="8" fill="#0D9488" font-family="system-ui">CERTIFIED</text>
          </svg>
        </div>
        <div class="w-12 h-12 rounded-lg bg-teal-100 flex items-center justify-center mb-4 group-hover:bg-teal-200 transition-colors relative z-10">
          <svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2 relative z-10">Training</h3>
        <p class="text-gray-600 relative z-10">Hands-on training for your employees. Custom documentation, workshops, and ongoing coaching.</p>
      </div>
    </div>
  </div>
</section>