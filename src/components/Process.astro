---
---
<section id="process" class="section-padding bg-gray-50">
  <div class="container-custom">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">How It Works</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">From consultation to ongoing support — a proven process for your private AI infrastructure.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-5 gap-4 relative">
      <div class="hidden md:block absolute top-12 left-[10%] right-[10%] h-0.5 bg-gradient-to-r from-indigo-100 via-purple-100 to-indigo-100 -z-10"></div>
      
      <!-- Step 1: Consultation -->
      <div class="card text-center relative overflow-hidden group">
        <div class="absolute top-4 right-4 w-24 h-24 opacity-5 group-hover:opacity-15 transition-opacity duration-500" aria-hidden="true">
          <svg viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="48" cy="48" r="40" stroke="#4F46E5" stroke-width="1.5" stroke-dasharray="8 4"/>
            <path d="M48 16 L48 32 M80 48 L64 48 M48 80 L48 64 M16 48 L32 48" stroke="#4F46E5" stroke-width="2" stroke-linecap="round"/>
            <circle cx="48" cy="48" r="12" fill="#4F46E5" opacity="0.2"/>
            <path d="M42 48 L46 52 L54 44" stroke="#4F46E5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <circle cx="32" cy="32" r="4" fill="#7C3AED" opacity="0.6"/>
            <circle cx="64" cy="32" r="4" fill="#4F46E5" opacity="0.6"/>
            <circle cx="32" cy="64" r="4" fill="#7C3AED" opacity="0.6"/>
            <circle cx="64" cy="64" r="4" fill="#4F46E5" opacity="0.6"/>
          </svg>
        </div>
        <span class="w-10 h-10 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center mx-auto mb-3 text-sm relative z-10">1</span>
        <h3 class="text-lg font-semibold text-gray-900 mb-2 relative z-10">Consultation</h3>
        <p class="text-gray-600 text-sm relative z-10">We analyze your business needs, current workflow, and recommend the ideal AI setup.</p>
      </div>
      
      <!-- Step 2: Design -->
      <div class="card text-center relative overflow-hidden group">
        <div class="absolute top-4 right-4 w-24 h-24 opacity-5 group-hover:opacity-15 transition-opacity duration-500" aria-hidden="true">
          <svg viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="12" y="12" width="72" height="72" rx="8" stroke="#7C3AED" stroke-width="2"/>
            <rect x="20" y="20" width="56" height="56" rx="4" stroke="#4F46E5" stroke-width="1" opacity="0.5"/>
            <line x1="28" y1="36" x2="68" y2="36" stroke="#7C3AED" stroke-width="2" stroke-linecap="round"/>
            <line x1="28" y1="48" x2="60" y2="48" stroke="#4F46E5" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="28" y1="60" x2="68" y2="60" stroke="#7C3AED" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="72" cy="24" r="6" fill="#4F46E5" opacity="0.4"/>
            <path d="M72 18 L72 30 M66 24 L78 24" stroke="#4F46E5" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <span class="w-10 h-10 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center mx-auto mb-3 text-sm relative z-10">2</span>
        <h3 class="text-lg font-semibold text-gray-900 mb-2 relative z-10">Design</h3>
        <p class="text-gray-600 text-sm relative z-10">Hardware specification, software stack selection, and integration architecture tailored to you.</p>
      </div>
      
      <!-- Step 3: Deploy -->
      <div class="card text-center relative overflow-hidden group">
        <div class="absolute top-4 right-4 w-24 h-24 opacity-5 group-hover:opacity-15 transition-opacity duration-500" aria-hidden="true">
          <svg viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="8" y="24" width="80" height="64" rx="8" stroke="#10B981" stroke-width="2"/>
            <rect x="16" y="32" width="64" height="16" rx="4" fill="#10B981" opacity="0.2"/>
            <rect x="20" y="56" width="56" height="28" rx="4" stroke="#059669" stroke-width="1.5"/>
            <circle cx="36" cy="70" r="5" fill="#10B981" opacity="0.5"/>
            <circle cx="60" cy="70" r="5" fill="#059669" opacity="0.5"/>
            <path d="M48 24 L48 16" stroke="#10B981" stroke-width="3" stroke-linecap="round"/>
            <circle cx="48" cy="12" r="4" fill="#10B981" opacity="0.6"/>
            <path d="M32 40 L64 40" stroke="#10B981" stroke-width="2" stroke-dasharray="4 4"/>
          </svg>
        </div>
        <span class="w-10 h-10 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center mx-auto mb-3 text-sm relative z-10">3</span>
        <h3 class="text-lg font-semibold text-gray-900 mb-2 relative z-10">Deploy</h3>
        <p class="text-gray-600 text-sm relative z-10">Assembly, Linux, Docker, AI models, agents, security configuration — all on-site.</p>
      </div>
      
      <!-- Step 4: Train -->
      <div class="card text-center relative overflow-hidden group">
        <div class="absolute top-4 right-4 w-24 h-24 opacity-5 group-hover:opacity-15 transition-opacity duration-500" aria-hidden="true">
          <svg viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="48" cy="32" r="14" fill="#0D9488" opacity="0.3"/>
            <circle cx="48" cy="32" r="8" fill="#0D9488" opacity="0.6"/>
            <path d="M48 26 L48 18 M40 32 L32 32 M56 32 L64 32" stroke="#0D9488" stroke-width="2" stroke-linecap="round"/>
            <path d="M16 68 L80 68" stroke="#0D9488" stroke-width="3" stroke-linecap="round"/>
            <path d="M16 68 L32 84 L64 52 L80 68" stroke="#0D9488" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <circle cx="32" cy="84" r="4" fill="#0D9488" opacity="0.5"/>
            <circle cx="64" cy="52" r="4" fill="#0D9488" opacity="0.5"/>
            <rect x="12" y="88" width="72" height="8" rx="4" fill="#0D9488" opacity="0.2"/>
            <text x="48" y="93.5" text-anchor="middle" font-size="6" fill="#0D9488" font-family="system-ui">COMPLETE</text>
          </svg>
        </div>
        <span class="w-10 h-10 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center mx-auto mb-3 text-sm relative z-10">4</span>
        <h3 class="text-lg font-semibold text-gray-900 mb-2 relative z-10">Train</h3>
        <p class="text-gray-600 text-sm relative z-10">Hands-on employee training. Custom documentation and best practices for your team.</p>
      </div>
      
      <!-- Step 5: Support -->
      <div class="card text-center relative overflow-hidden group">
        <div class="absolute top-4 right-4 w-24 h-24 opacity-5 group-hover:opacity-15 transition-opacity duration-500" aria-hidden="true">
          <svg viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="48" cy="48" r="38" stroke="#4F46E5" stroke-width="1.5" stroke-dasharray="12 6"/>
            <circle cx="48" cy="48" r="28" stroke="#7C3AED" stroke-width="1" opacity="0.5"/>
            <path d="M48 16 L48 30 M80 48 L66 48 M48 80 L48 66 M16 48 L30 48" stroke="#4F46E5" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="48" cy="48" r="10" fill="url(#supportGrad)" opacity="0.4"/>
            <defs>
              <radialGradient id="supportGrad" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#4F46E5"/>
                <stop offset="100%" stop-color="#7C3AED"/>
              </radialGradient>
            </defs>
            <path d="M44 48 L47 51 L53 45" stroke="#4F46E5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <circle cx="30" cy="30" r="3" fill="#7C3AED" opacity="0.7"/>
            <circle cx="66" cy="30" r="3" fill="#4F46E5" opacity="0.7"/>
            <circle cx="30" cy="66" r="3" fill="#7C3AED" opacity="0.7"/>
            <circle cx="66" cy="66" r="3" fill="#4F46E5" opacity="0.7"/>
          </svg>
        </div>
        <span class="w-10 h-10 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center mx-auto mb-3 text-sm relative z-10">5</span>
        <h3 class="text-lg font-semibold text-gray-900 mb-2 relative z-10">Support</h3>
        <p class="text-gray-600 text-sm relative z-10">Remote monitoring, updates, model optimization, and ongoing maintenance contract.</p>
      </div>
    </div>
  </div>
</section>