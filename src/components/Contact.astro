---
---
<section id="contact" class="section-padding bg-gray-50">
  <div class="container-custom max-w-3xl">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Get in Touch</h2>
      <p class="text-lg text-gray-600">Ready to deploy private AI infrastructure? Let's discuss your needs.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <div class="card text-center p-8">
        <div class="w-14 h-14 rounded-xl bg-indigo-100 flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Email</h3>
        <a href="mailto:mmusa.sr@gmail.com" class="text-indigo-600 hover:text-indigo-700 font-medium">mmusa.sr@gmail.com</a>
        <p class="text-sm text-gray-500 mt-1">Reply within 24 hours</p>
      </div>
      
      <div class="card text-center p-8">
        <div class="w-14 h-14 rounded-xl bg-green-100 flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">WhatsApp</h3>
        <a href="https://wa.me/905525400206" target="_blank" rel="noopener" class="text-green-600 hover:text-green-700 font-medium">+90 552 540 02 06</a>
        <p class="text-sm text-gray-500 mt-1">Direct message</p>
      </div>
      
      <div class="card text-center p-8">
        <div class="w-14 h-14 rounded-xl bg-purple-100 flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Location</h3>
        <span class="text-gray-600">Antalya, Turkey</span>
        <p class="text-sm text-gray-500 mt-1">Serving Europe remotely</p>
      </div>
    </div>

    <div class="card bg-indigo-50 border-indigo-100 p-8 text-center">
      <h3 class="text-xl font-bold text-gray-900 mb-4">Prefer a quick call?</h3>
      <p class="text-gray-600 mb-6 max-w-xl mx-auto">Book a 15-minute discovery call — we'll discuss your infrastructure needs and outline a custom deployment plan.</p>
      <a href="https://calendly.com/musa-sari/30min" target="_blank" rel="noopener" class="btn-primary inline-flex items-center gap-2">
        Schedule a Call
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>