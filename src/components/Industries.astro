<section id="industries" class="section-padding bg-gray-50">
  <div class="container-custom">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Industries We Serve</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">Data-sensitive industries where privacy-first AI makes the difference.</p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
      <div class="card text-center hover:border-indigo-300"><span class="text-3xl mb-2 block">⚖️</span><h3 class="font-semibold text-gray-900">Law Firms</h3></div>
      <div class="card text-center hover:border-indigo-300"><span class="text-3xl mb-2 block">🏥</span><h3 class="font-semibold text-gray-900">Healthcare</h3></div>
      <div class="card text-center hover:border-indigo-300"><span class="text-3xl mb-2 block">📊</span><h3 class="font-semibold text-gray-900">Accounting</h3></div>
      <div class="card text-center hover:border-indigo-300"><span class="text-3xl mb-2 block">🏭</span><h3 class="font-semibold text-gray-900">Manufacturing</h3></div>
      <div class="card text-center hover:border-indigo-300"><span class="text-3xl mb-2 block">⚙️</span><h3 class="font-semibold text-gray-900">Engineering</h3></div>
      <div class="card text-center hover:border-indigo-300"><span class="text-3xl mb-2 block">🏠</span><h3 class="font-semibold text-gray-900">Real Estate</h3></div>
      <div class="card text-center hover:border-indigo-300"><span class="text-3xl mb-2 block">🎓</span><h3 class="font-semibold text-gray-900">Education</h3></div>
      <div class="card text-center hover:border-indigo-300"><span class="text-3xl mb-2 block">📱</span><h3 class="font-semibold text-gray-900">Marketing Agencies</h3></div>
      <div class="card text-center hover:border-indigo-300"><span class="text-3xl mb-2 block">🏦</span><h3 class="font-semibold text-gray-900">Finance</h3></div>
      <div class="card text-center hover:border-indigo-300"><span class="text-3xl mb-2 block">🏛️</span><h3 class="font-semibold text-gray-900">Government</h3></div>
    </div>
  </div>
</section>